{
  "name": "rankedgamer",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "rankedgamer.com", "custom_domain": true }
  ]
}